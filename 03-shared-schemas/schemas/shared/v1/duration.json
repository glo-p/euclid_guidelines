{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.company.com/shared/v1/duration.json",
  "title": "Duration",
  "description": "An ISO 8601 duration. Only the time-and-day forms are permitted (no months or years, whose length is ambiguous).",
  "x-lifecycle": "active",
  "type": "string",
  "format": "duration",
  "pattern": "^P(?!$)([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?)?$",
  "examples": ["PT15M", "P1DT12H", "PT30S"]
}
